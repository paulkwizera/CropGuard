# Copy to .env (same folder as this file) and fill in. NEVER commit .env.

# --- Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
# On Render the service's own address is added automatically, and DEBUG defaults to False there.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# The live website's address (allowed to call the API). Already defaults to the CropGuard Render site.
# FRONTEND_URL=https://cropguard-9fmd.onrender.com
# Where uploaded leaf photos are kept. On Render, point this at a persistent disk, e.g. /var/data/media
# MEDIA_ROOT=/var/data/media
# LOG_LEVEL=INFO

# --- MongoDB (local Docker, or paste a MongoDB Atlas connection string)
MONGODB_URI=mongodb://localhost:27017
MONGODB_NAME=cropguard

# --- AI model
# Maize model: ml/weights/best.pt. Cassava model: ml/weights/cassava.pt (switches on when the file exists).
# YOLO_MODEL_MAIZE_PATH=../ml/weights/best.pt
# YOLO_MODEL_CASSAVA_PATH=../ml/weights/cassava.pt
# Minimum confidence to report a disease. Lower it (0.25-0.4) if real diseased leaves are not detected.
YOLO_CONF=0.5
# The maize model was trained at 640.
YOLO_IMGSZ=640

# --- External APIs
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Used in this order if GEMINI_MODEL is busy, over quota or unavailable. Keep these current (comma-separated).
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash
# How hard Gemini "thinks" before answering. low = fast (recommended). Valid: low, medium, high. Never "minimal" (3.7/3.8 refuse it).
GEMINI_THINKING=low
# Seconds for one request to Google / for a whole answer including retries.
GEMINI_TIMEOUT=25
GEMINI_BUDGET=45
OPENWEATHER_API_KEY=

# Questions per minute each farmer may ask the AI assistant
ASSISTANT_RATE=30/min
